# Phylax Backend Environment Variables Example
# Copy this file to backend/.env and replace placeholders with actual values.

# Security
SECRET_KEY=your_secure_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
DATABASE_URL=sqlite:///./traffic_control.db

# Optional Provider Integration API Keys (Twilio / SendGrid / SMTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@phylax.ai
SMTP_PASSWORD=your_smtp_password
